<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <RootNamespace>codecrush.gstreamer.net.tests</RootNamespace>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="coverlet.collector" Version="6.0.4"/>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1"/>
        <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4"/>
        <PackageReference Include="xunit.v3" Version="3.2.2" />
    </ItemGroup>

    <ItemGroup>
        <Using Include="Xunit"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\codecrush.gstreamer.net\codecrush.gstreamer.net.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!--
            Files the drift tests compare against what is compiled in. Copied to
            the output so the tests do not have to guess at the repository
            layout.
        -->
        <None Include="..\gstreamer\subprojects\gstreamer-sharp\sources\generated\GtkSharp\ObjectManager.cs"
              Link="upstream\ObjectManager.cs"
              CopyToOutputDirectory="PreserveNewest"/>
        <None Include="..\codecrush.gstreamer.net\Overrides\ObjectManager.cs"
              Link="overrides\ObjectManager.cs"
              CopyToOutputDirectory="PreserveNewest"/>
    </ItemGroup>

</Project>
