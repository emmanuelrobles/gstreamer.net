<configuration>
  <!--
    SYSTEM runtime profile overlay.

    The base map is gstreamer-sharp's own gstreamer-sharp.dll.config, taken
    straight from the submodule and included as-is, so anything upstream adds
    there flows into the generated map on the next submodule bump. Only the
    entries upstream gets wrong belong here; each one replaces the base entry
    for the same (os, dll) and is applied last.
  -->
  <!-- Upstream maps glib and gobject to names without the "lib" prefix they have. -->
  <dllmap dll="glib-2.0-0.dll" target="libglib-2.0.so.0" os="linux"/>
  <dllmap dll="gobject-2.0-0.dll" target="libgobject-2.0.so.0" os="linux"/>

  <!-- Upstream has no gio entry at all. -->
  <dllmap dll="gio-2.0-0.dll" target="libgio-2.0.so.0" os="linux"/>

  <dllmap dll="glib-2.0-0.dll" target="libglib-2.0.0.dylib" os="osx"/>
  <dllmap dll="gobject-2.0-0.dll" target="libgobject-2.0.0.dylib" os="osx"/>
  <dllmap dll="gio-2.0-0.dll" target="libgio-2.0.0.dylib" os="osx"/>

  <!--
    gthread is part of glib and follows the same macOS naming as the three above,
    which upstream also gets wrong.
  -->
  <dllmap dll="gthread-2.0-0.dll" target="libgthread-2.0.0.dylib" os="osx"/>

  <!--
    No Windows section: the official GStreamer Windows runtime already uses the
    names the bindings declare (gstreamer-1.0-0.dll, glib-2.0-0.dll, ...), so
    the identity mapping is the correct one there.
  -->
</configuration>
