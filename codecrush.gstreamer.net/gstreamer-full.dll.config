<configuration>
  <!--
    FULL runtime profile: a self-contained GStreamer built with
    -Dgst-full-target-type=shared_library. Every GStreamer library the bindings
    declare is a set of exports inside one libgstreamer-full-1.0, so all of them
    map onto that single file.

    glib, gobject and gio are NOT part of gst-full - they are shipped next to
    it - so they keep their own file names.

    gstwebrtc, gstrtsp and gstrtspserver are deliberately absent: the reduced
    runtime does not build gst-plugins-bad (no gstwebrtc) and does not expose
    gst-plugins-rtsp. They stay unmapped, so only code that actually calls into
    Gst.WebRTC / Gst.Rtsp fails, instead of Gst.Application failing at startup.
    gthread is absent because nothing the bindings compile DllImports it.
  -->
  <!-- Linux: SONAME of the gst-full build has no version suffix -->
  <dllmap dll="gstreamer-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstapp-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstaudio-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstbase-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstcontroller-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstfft-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstnet-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstpbutils-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstrtp-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstsdp-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gsttag-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="gstvideo-1.0-0.dll" target="libgstreamer-full-1.0.so" os="linux"/>
  <dllmap dll="glib-2.0-0.dll" target="libglib-2.0.so.0" os="linux"/>
  <dllmap dll="gobject-2.0-0.dll" target="libgobject-2.0.so.0" os="linux"/>
  <dllmap dll="gio-2.0-0.dll" target="libgio-2.0.so.0" os="linux"/>
  <!-- Windows: MinGW-w64 build, so the bundled DLLs carry the "lib" prefix -->
  <dllmap dll="gstreamer-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstapp-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstaudio-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstbase-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstcontroller-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstfft-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstnet-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstpbutils-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstrtp-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstsdp-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gsttag-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="gstvideo-1.0-0.dll" target="libgstreamer-full-1.0.dll" os="windows"/>
  <dllmap dll="glib-2.0-0.dll" target="libglib-2.0-0.dll" os="windows"/>
  <dllmap dll="gobject-2.0-0.dll" target="libgobject-2.0-0.dll" os="windows"/>
  <dllmap dll="gio-2.0-0.dll" target="libgio-2.0-0.dll" os="windows"/>
</configuration>
