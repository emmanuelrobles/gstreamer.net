<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        
        <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
        
        <IsPackable>true</IsPackable>
        <PackageId>CodeCrush.gstreamer</PackageId>
        <Authors>Emmanuel Robles</Authors>
        <Company>CodeCrush</Company>
        <Description>.NET package for CodeCrush GStreamer integration.</Description>
        <PackageTags>gstreamer;media;dotnet</PackageTags>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://forgejo.codecrush.dev/CodeCrush/codecrush.gstreamer.net</RepositoryUrl>
    </PropertyGroup>
    
    <PropertyGroup>
        <GStreamerSharpSourcesDir>../gstreamer/subprojects/gstreamer-sharp/sources/</GStreamerSharpSourcesDir>
    </PropertyGroup>
    
    <ItemGroup>
        <!--
            gstreamer-sharp's sources, minus custom/Application.cs: the local
            Overrides/Application.cs replaces it (no eager Gst.WebRTC GType
            registration, plus gst_init_static_plugins() for gst-full).
        -->
        <Compile Include="$(GStreamerSharpSourcesDir)/generated/**/*.cs" />
        <Compile Include="$(GStreamerSharpSourcesDir)/custom/**/*.cs" />
        <Compile Remove="$(GStreamerSharpSourcesDir)/custom/Application.cs" />
        <!--
            The dllmap documents, one profile each. The file name picks the
            profile; a ".overlay" in the name means the file is applied on top
            of that profile's base file, entry by entry.

            gstreamer-sharp.dll.config is consumed straight from the submodule,
            so a submodule bump that adds a library needs no copy step here.
            gstreamer-sharp.overlay.dll.config only carries the entries upstream
            gets wrong or does not have. gstreamer-full.dll.config has no
            upstream counterpart - it is ours.
        -->
        <AdditionalFiles Include="$(GStreamerSharpSourcesDir)gstreamer-sharp.dll.config"/>
        <AdditionalFiles Include="gstreamer-sharp.overlay.dll.config"/>
        <AdditionalFiles Include="gstreamer-full.dll.config"/>
    </ItemGroup>
    
    <ItemGroup>
        <PackageReference Include="GLibSharp.GLibSharp" Version="3.22.0" />
        <PackageReference Include="GLibSharp.GioSharp" Version="3.22.0" />
        <PackageReference Include="GLibSharp.AtkSharp" Version="3.22.0" />
    </ItemGroup> 
    
    <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\" />
    </ItemGroup> 
    
    <ItemGroup>
      <ProjectReference Include="..\codecrush.gstreamer.source-generator\codecrush.gstreamer.source-generator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false"/>
    </ItemGroup>
    
</Project>
